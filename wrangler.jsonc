{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "new-website",
	"account_id": "4cc581d16c068c7efa801938208bce1c",
	"compatibility_date": "2026-09-18",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	}
}
